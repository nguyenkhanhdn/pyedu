@model IList<TechKidPro.Core.Entities.Assessments.Assessment>
@{ ViewBag.Title = "Bài kiểm tra"; }
<h2>Bài kiểm tra / Luyện tập</h2>
<p>@Html.ActionLink("+ Tạo mới", "Create", null, new { @class = "btn btn-primary" })
   @Html.ActionLink("Câu hỏi", "Index", "Questions", new { area = "Admin" }, new { @class = "btn btn-default" })
   @Html.ActionLink("Kỹ năng", "Index", "Skills", new { area = "Admin" }, new { @class = "btn btn-default" })</p>
<div class="table-responsive"><table class="table table-striped">
<tr><th>Id</th><th>Tiêu đề</th><th>Loại</th><th>Trạng thái</th><th></th></tr>
@foreach (var a in Model) { <tr><td>@a.Id</td><td>@a.Title</td><td>@a.Type</td><td>@a.Status</td><td>@Html.ActionLink("Quản lý", "Edit", new { id = a.Id })</td></tr> }
</table></div>
