@model TechKidPro.Web.Models.LessonEditViewModel
@using TechKidPro.Core.Enums
@{ ViewBag.Title = "Bài học: " + Model.Title; ViewBag.VideoProvider = new TechKidPro.Infrastructure.Providers.YouTubeVideoProvider(); }
@if (TempData["Message"] != null) { <div class="alert alert-success">@TempData["Message"]</div> }
<p>@Html.ActionLink("← Đề cương", "Curriculum", new { id = Model.CourseId })</p>
<h2>Bài học</h2>
@using (Html.BeginForm("Lesson", "Courses", new { area = "Admin" })) {
    @Html.AntiForgeryToken() @Html.HiddenFor(m => m.Id) @Html.HiddenFor(m => m.CourseId)
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="form-group">@Html.LabelFor(m => m.Title)@Html.TextBoxFor(m => m.Title, new { @class = "form-control" })</div>
    <div class="form-group">@Html.LabelFor(m => m.SortOrder)@Html.TextBoxFor(m => m.SortOrder, new { @class = "form-control", type = "number" })</div>
    <div class="form-group">@Html.LabelFor(m => m.Status)@Html.EnumDropDownListFor(m => m.Status, new { @class = "form-control" })</div>
    <button class="btn btn-primary">Lưu bài học</button>
}
<h3>Nội dung</h3>
@foreach (var c in Model.Contents) {
  <div class="panel panel-default"><div class="panel-heading">@c.BlockType
    @using (Html.BeginForm("DeleteContent", "Courses", new { area = "Admin" }, FormMethod.Post, new { style = "display:inline" })) {
        @Html.AntiForgeryToken() @Html.Hidden("id", Model.Id) @Html.Hidden("contentId", c.Id)
        <button class="btn btn-link btn-xs text-danger">Xóa</button>
    }</div>
    <div class="panel-body">@{ Html.RenderPartial("~/Views/Shared/_LessonBlock.cshtml", c, ViewData); }</div></div>
}
<h4>Thêm block</h4>
@using (Html.BeginForm("AddContent", "Courses", new { area = "Admin" })) {
    @Html.AntiForgeryToken() @Html.Hidden("id", Model.Id)
    <div class="form-group"><label>Loại</label>
      <select name="type" class="form-control">
        @foreach (LessonBlockType t in Enum.GetValues(typeof(LessonBlockType))) { <option value="@t">@t</option> }
      </select></div>
    <div class="form-group"><label>Văn bản / Code</label><textarea name="text" rows="5" class="form-control"></textarea></div>
    <div class="form-group"><label>URL (Video/Image/File/Embed)</label><input name="url" class="form-control" placeholder="https://..." /></div>
    <div class="form-group"><label>Id bài kiểm tra (block Quiz)</label><input name="assessmentId" type="number" class="form-control" /></div>
    <div class="form-group"><label>Tiêu đề / chú thích</label><input name="title" class="form-control" /></div>
    <button class="btn btn-primary">Thêm</button>
}
