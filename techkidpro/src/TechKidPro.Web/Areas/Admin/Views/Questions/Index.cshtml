@model IList<TechKidPro.Core.Entities.Assessments.Question>
@using TechKidPro.Core.Enums
@{ ViewBag.Title = "Ngân hàng câu hỏi"; int? courseId = (int?)ViewBag.CourseId; }
<h2>Ngân hàng câu hỏi</h2>
@if (TempData["Message"] != null) { <div class="alert alert-success">@TempData["Message"]</div> }
@using (Html.BeginForm("Index", "Questions", new { area = "Admin" }, FormMethod.Get, new { @class = "form-inline" })) {
    <select name="courseId" class="form-control"><option value="">-- Mọi khóa học --</option>
      @foreach (var c in (IEnumerable<TechKidPro.Core.Entities.Catalog.Course>)ViewBag.Courses) { <option value="@c.Id" @(courseId == c.Id ? "selected" : "")>@c.Title</option> }</select>
    <select name="skillId" class="form-control"><option value="">-- Mọi kỹ năng --</option>
      @foreach (var s in (IEnumerable<TechKidPro.Core.Entities.Skills.Skill>)ViewBag.Skills) { <option value="@s.Id" @((int?)ViewBag.SkillId == s.Id ? "selected" : "")>@s.Name</option> }</select>
    <button class="btn btn-default">Lọc</button>
    @Html.ActionLink("+ Câu hỏi mới", "Create", new { courseId }, new { @class = "btn btn-primary" })
}
<div class="table-responsive"><table class="table table-striped">
<tr><th>#</th><th>Câu hỏi</th><th>Loại</th><th>Độ khó</th><th>Kỹ năng</th><th>Trạng thái</th><th></th></tr>
@foreach (var q in Model) {
  <tr><td>@q.Id</td><td>@q.Text</td><td>@q.Type</td><td>@q.Difficulty</td>
  <td>@string.Join(", ", q.Skills.Select(s => s.Skill.Name))</td><td>@q.Status</td>
  <td>@Html.ActionLink("Sửa", "Edit", new { id = q.Id })
    @foreach (var st in new[] { PublishStatus.Published, PublishStatus.Archived }) { if (st != q.Status) {
      using (Html.BeginForm("SetStatus", "Questions", new { area = "Admin" }, FormMethod.Post, new { style = "display:inline" })) {
        @Html.AntiForgeryToken() @Html.Hidden("id", q.Id) @Html.Hidden("status", st) @Html.Hidden("courseId", courseId)
        <button class="btn btn-link btn-xs">→ @st</button> } } }
  </td></tr>
}</table></div>
