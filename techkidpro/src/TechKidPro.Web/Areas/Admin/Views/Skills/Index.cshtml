@model IList<TechKidPro.Core.Entities.Skills.Skill>
@{ ViewBag.Title = "Kỹ năng"; }
<h2>Kỹ năng</h2>
@if (TempData["Message"] != null) { <div class="alert alert-success">@TempData["Message"]</div> }
<div class="table-responsive"><table class="table table-striped"><tr><th>Mã</th><th>Tên</th><th>Nhóm</th><th>Khóa học</th></tr>
@foreach (var s in Model) {
  <tr><td>@s.Code</td><td>@s.Name</td><td>@(s.Category == null ? "" : s.Category.Name)</td><td>@s.CourseId</td></tr>
}</table></div>
<h4>Thêm kỹ năng</h4>
@using (Html.BeginForm("CreateSkill", "Skills", new { area = "Admin" }, FormMethod.Post, new { @class = "form-inline" })) {
    @Html.AntiForgeryToken()
    <input name="name" class="form-control" placeholder="Tên (vd: Vòng lặp)" required />
    <input name="code" class="form-control" placeholder="Mã (tùy chọn)" />
    <select name="courseId" class="form-control"><option value="">-- Dùng chung --</option>
      @foreach (var c in (IEnumerable<TechKidPro.Core.Entities.Catalog.Course>)ViewBag.Courses) { <option value="@c.Id">@c.Title</option> }</select>
    <select name="categoryId" class="form-control"><option value="">-- Nhóm --</option>
      @foreach (var c in (IEnumerable<TechKidPro.Core.Entities.Skills.SkillCategory>)ViewBag.Categories) { <option value="@c.Id">@c.Name</option> }</select>
    <button class="btn btn-primary">Thêm</button>
}
<h4 style="margin-top:20px">Thêm nhóm kỹ năng</h4>
@using (Html.BeginForm("CreateCategory", "Skills", new { area = "Admin" }, FormMethod.Post, new { @class = "form-inline" })) {
    @Html.AntiForgeryToken()
    <input name="name" class="form-control" placeholder="Tên nhóm" required />
    <button class="btn btn-default">Thêm nhóm</button>
}
