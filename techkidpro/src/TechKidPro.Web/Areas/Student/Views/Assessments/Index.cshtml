@model IList<TechKidPro.Core.Entities.Assessments.Assessment>
@{ var course = (TechKidPro.Core.Entities.Catalog.Course)ViewBag.Course; ViewBag.Title = "Bài kiểm tra - " + course.Title; }
<h2>Bài kiểm tra: @course.Title</h2>
<p>@Html.ActionLink("← Về khóa học", "Learn", "Courses", new { area = "Student", slug = course.Slug }, null)</p>
@if (!Model.Any()) { <p class="text-muted">Chưa có bài kiểm tra nào.</p> }
<div class="list-group">
@foreach (var a in Model) {
  <a class="list-group-item" href="@Url.Action("Intro", new { id = a.Id })"><strong>@a.Title</strong> <span class="label label-info">@a.Type</span>
  @if (a.TimeLimitMinutes.HasValue) { <small class="text-muted"> · @a.TimeLimitMinutes phút</small> }</a>
}
</div>
