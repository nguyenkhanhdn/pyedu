@model TechKidPro.Services.Assessments.AttemptResult
@{ ViewBag.Title = "Kết quả"; var t = Model.Attempt; var n = 0; }
<h2>Kết quả: @Model.Assessment.Title</h2>
<div class="alert @(t.Passed ? "alert-success" : "alert-danger")">
  <h3 style="margin-top:0">@t.Percent% — @(t.Passed ? "Đạt" : "Chưa đạt")</h3>
  Điểm: @t.Score / @t.MaxScore (điểm đạt @Model.Assessment.PassPercent%)
</div>
@if (Model.Skills.Any()) {
  <h4>Theo kỹ năng</h4>
  foreach (var s in Model.Skills) {
    <div>@s.Name <small class="text-muted">(@s.Correct/@s.Total)</small>
    <div class="progress"><div class="progress-bar @(s.Percent < 60 ? "progress-bar-danger" : "progress-bar-success")" style="width:@(s.Percent)%">@s.Percent%</div></div></div>
  }
}
@if (Model.WeakSkills.Any() || Model.RecommendedLessons.Any()) {
  <div class="panel panel-warning"><div class="panel-heading">Gợi ý ôn tập</div><div class="panel-body">
  @if (Model.WeakSkills.Any()) { <p>Bạn đang yếu: @string.Join(", ", Model.WeakSkills.Select(w => w.Name + " (" + w.Percent + "%)"))</p> }
  @foreach (var l in Model.RecommendedLessons) { <div>→ @Html.ActionLink(l.Title, "Learn", "Courses", new { area = "Student", slug = l.CourseSlug, lessonId = l.LessonId }, null)</div> }
  </div></div>
}
<h4>Chi tiết</h4>
@foreach (var it in Model.Items) {
  n++;
  <div class="panel @(it.IsCorrect ? "panel-success" : "panel-danger")"><div class="panel-heading">Câu @n: @it.Text <span class="pull-right">@it.PointsAwarded/@it.MaxPoints</span></div>
  <div class="panel-body">
    @foreach (var o in it.Options) {
      <div class="@(Model.ShowAnswers && o.IsCorrect == true ? "text-success" : "")">
        @(o.Selected ? "☑" : "☐") @o.Text @if (Model.ShowAnswers && o.IsCorrect == true) { <strong>(đáp án đúng)</strong> }
      </div>
    }
    @if (!string.IsNullOrWhiteSpace(it.Explanation)) { <p class="text-muted" style="margin-top:8px">Giải thích: @it.Explanation</p> }
  </div></div>
}
<p>@Html.ActionLink("Quay lại bài kiểm tra", "Intro", new { id = Model.Assessment.Id }, new { @class = "btn btn-default" })</p>
