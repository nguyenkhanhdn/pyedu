@model TechKidPro.Services.Assessments.TakeModel
@using TechKidPro.Core.Enums
@{ ViewBag.Title = Model.Assessment.Title; var n = 0; }
<h2>@Model.Assessment.Title</h2>
@if (Model.DeadlineUtc.HasValue) { <div class="alert alert-warning">Thời gian còn lại: <strong id="timer"></strong></div> }
@using (Html.BeginForm("Submit", "Assessments", new { area = "Student" }, FormMethod.Post, new { id = "quizForm" })) {
  @Html.AntiForgeryToken() @Html.Hidden("attemptId", Model.Attempt.Id)
  foreach (var q in Model.Questions) {
    n++;
    <div class="panel panel-default"><div class="panel-body">
      <p><strong>Câu @n.</strong> @q.Text @if (q.Type == QuestionType.MultipleChoice) { <em class="text-muted">(chọn nhiều đáp án)</em> }</p>
      @foreach (var o in q.Options) {
        if (q.Type == QuestionType.MultipleChoice) { <div class="checkbox"><label><input type="checkbox" name="q_@q.Id" value="@o.Id" /> @o.Text</label></div> }
        else { <div class="radio"><label><input type="radio" name="q_@q.Id" value="@o.Id" /> @o.Text</label></div> }
      }
    </div></div>
  }
  <button class="btn btn-primary btn-lg" type="submit" onclick="return confirm('Nộp bài?')">Nộp bài</button>
}
@section scripts {
@if (Model.DeadlineUtc.HasValue) {
<script>
  (function () {
    var end = new Date('@Model.DeadlineUtc.Value.ToString("o")').getTime();
    var el = document.getElementById('timer'), form = document.getElementById('quizForm');
    function tick() {
      var left = Math.max(0, Math.floor((end - Date.now()) / 1000));
      el.textContent = Math.floor(left / 60) + ':' + ('0' + (left % 60)).slice(-2);
      if (left <= 0) { form.submit(); return; }
      setTimeout(tick, 1000);
    }
    tick();
  })();
</script>
}
}
