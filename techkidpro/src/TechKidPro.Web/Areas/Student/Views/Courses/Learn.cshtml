@model TechKidPro.Web.Models.LearnViewModel
@using TechKidPro.Core.Enums
@{ ViewBag.Title = Model.Course.Title; }
@if (TempData["Message"] != null) { <div class="alert alert-success">@TempData["Message"]</div> }
<div class="row">
  <div class="col-md-3 col-md-push-0">
    <h4>@Model.Course.Title</h4>
    <div class="progress"><div class="progress-bar" style="width:@(Model.Progress.Percent)%">@Model.Progress.Percent%</div></div>
    @foreach (var s in Model.Course.Sections) {
        <div class="panel panel-default">
            <div class="panel-heading"><strong>@s.Title</strong></div>
            <div class="list-group">
            @foreach (var l in s.Lessons) {
                var done = Model.Progress.CompletedLessonIds.Contains(l.Id);
                var active = Model.Lesson != null && Model.Lesson.Id == l.Id;
                <a class="list-group-item @(active ? "active" : "")" href="@Url.Action("Learn", new { slug = Model.Course.Slug, lessonId = l.Id })">
                    @(done ? "✓" : "○") @l.Title
                </a>
            }
            </div>
        </div>
    }
  </div>
  <div class="col-md-9">
  @if (Model.Lesson == null) {
      <p class="text-muted">Khóa học chưa có bài học.</p>
  } else {
      <h3>@Model.Lesson.Title</h3>
      foreach (var c in Model.Contents) { Html.RenderPartial("~/Views/Shared/_LessonBlock.cshtml", c, ViewData); }
      <hr />
      <div class="clearfix">
        @if (Model.Previous != null) { @Html.ActionLink("← Bài trước", "Learn", new { slug = Model.Course.Slug, lessonId = Model.Previous.Id }, new { @class = "btn btn-default" }) }
        @if (User.IsInRole("Student")) {
          using (Html.BeginForm("Complete", "Courses", new { area = "Student" }, FormMethod.Post, new { @class = "pull-right" })) {
            @Html.AntiForgeryToken()
            @Html.Hidden("slug", Model.Course.Slug)
            @Html.Hidden("lessonId", Model.Lesson.Id)
            @Html.Hidden("nextLessonId", Model.Next == null ? (int?)null : Model.Next.Id)
            if (Model.Progress.CompletedLessonIds.Contains(Model.Lesson.Id)) {
                <button class="btn btn-default" type="submit">Đã hoàn thành ✓ @(Model.Next != null ? "– Bài tiếp" : "")</button>
            } else {
                <button class="btn btn-success" type="submit">Hoàn thành bài học</button>
            }
          }
        }
      </div>
  }
  </div>
</div>
