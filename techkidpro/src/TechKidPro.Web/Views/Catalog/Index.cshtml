@model TechKidPro.Web.Models.CatalogIndexViewModel
@{ ViewBag.Title = "Khóa học"; }
<h2>Khóa học</h2>
<p>
    @Html.ActionLink("Tất cả", "Index", new { category = "" }, new { @class = "btn btn-xs " + (string.IsNullOrEmpty(Model.CategorySlug) ? "btn-primary" : "btn-default") })
    @foreach (var c in Model.Categories) {
        @Html.ActionLink(c.Name, "Index", new { category = c.Slug }, new { @class = "btn btn-xs " + (Model.CategorySlug == c.Slug ? "btn-primary" : "btn-default") })
    }
</p>
@if (!Model.Courses.Any()) { <p class="text-muted">Chưa có khóa học nào.</p> }
<div class="row">
@foreach (var c in Model.Courses) {
    <div class="col-sm-6 col-md-4">
        <div class="thumbnail">
            @if (!string.IsNullOrEmpty(c.ThumbnailUrl)) { <img src="@c.ThumbnailUrl" alt="" class="img-responsive" /> }
            <div class="caption">
                <h4>@c.Title</h4>
                <p>@c.Summary</p>
                <p>@Html.ActionLink("Xem chi tiết", "Details", new { slug = c.Slug }, new { @class = "btn btn-primary" })</p>
            </div>
        </div>
    </div>
}
</div>
