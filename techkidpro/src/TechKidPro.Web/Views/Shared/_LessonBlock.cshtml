@model TechKidPro.Core.Entities.Catalog.LessonContent
@using TechKidPro.Core.Enums
@using TechKidPro.Services.Courses
@using TechKidPro.Services.Common
@{
    var d = LessonBlockData.Parse(Model.DataJson);
    var videoProvider = ViewBag.VideoProvider as TechKidPro.Core.Interfaces.IVideoProvider;
}
@* Mọi giá trị đều được Razor HTML-encode; URL chỉ render khi là http/https. *@
@switch (Model.BlockType) {
    case LessonBlockType.Text:
        foreach (var para in (d.Text ?? "").Replace("\r", "").Split('\n')) {
            if (para.Trim().Length > 0) { <p>@para</p> }
        }
        break;
    case LessonBlockType.Code:
        <pre><code>@d.Text</code></pre>
        break;
    case LessonBlockType.Image:
        if (UrlSafety.IsHttp(d.Url)) { <p><img src="@d.Url" alt="@d.Title" class="img-responsive" /></p> }
        break;
    case LessonBlockType.Video:
        var embed = videoProvider == null ? null : videoProvider.GetEmbedUrl(d.Url);
        if (embed != null) {
            <div class="embed-responsive embed-responsive-16by9"><iframe class="embed-responsive-item" src="@embed" allowfullscreen></iframe></div>
        } else if (UrlSafety.IsHttp(d.Url)) {
            <p><a href="@d.Url" target="_blank" rel="noopener noreferrer">@(string.IsNullOrEmpty(d.Title) ? "Xem video" : d.Title)</a></p>
        }
        break;
    case LessonBlockType.File:
    case LessonBlockType.Embed:
        if (UrlSafety.IsHttp(d.Url)) { <p><a href="@d.Url" target="_blank" rel="noopener noreferrer">@(string.IsNullOrEmpty(d.Title) ? d.Url : d.Title)</a></p> }
        break;
    case LessonBlockType.Quiz:
        if (d.AssessmentId.HasValue) {
            <p>@Html.ActionLink("Làm bài kiểm tra", "Intro", "Assessments", new { area = "Student", id = d.AssessmentId.Value }, new { @class = "btn btn-info" })</p>
        }
        break;
}
